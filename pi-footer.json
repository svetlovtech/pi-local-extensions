{
  "version": 1,
  "enabled": true,
  "preset": "default",
  "separator": "dot",
  "separatorFg": "default",
  "separatorBg": "default",
  "iconMode": "text",
  "minimalist": false,
  "terminal": {
    "widthMode": "full",
    "colorLevel": "ansi256"
  },
  "lines": [
    [
      { "type": "model-provider", "options": { "raw": true } },
      { "type": "thinking-level", "options": { "raw": true, "hideWhenEmpty": true, "icon": "think: ", "fg": "magenta" } },
      { "type": "external-status", "options": { "externalStatusKey": "ctx", "icon": "ctx ", "hideWhenEmpty": true } },
      { "type": "external-status", "options": { "externalStatusKey": "cache", "icon": "cache ", "hideWhenEmpty": true } },
      { "type": "cost", "options": { "costFormatStyle": "compact", "raw": true } },
      { "type": "external-status", "options": { "externalStatusKey": "execution-time", "hideWhenEmpty": true, "trimValue": 2 } }
    ],
    [
      { "type": "external-status", "options": { "externalStatusKey": "mcp-count", "hideWhenEmpty": true, "raw": true } },
      { "type": "total-tokens", "options": { "tokenFormatStyle": "compact", "icon": "tok " } },
      { "type": "total-time", "options": { "icon": "total " } },
      { "type": "external-status", "options": { "externalStatusKey": "active-time", "hideWhenEmpty": true, "raw": true } }
    ]
  ],
  "extensionStatusRow": {
    "hiddenKeys": ["mcp", "mcp-count", "execution-time", "ctx", "cache", "active-time"],
    "knownKeys": ["mcp", "mcp-count", "execution-time", "ctx", "cache", "active-time"]
  }
}
